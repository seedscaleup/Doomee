# Copiez ce fichier en .env.local (en local) ou renseignez ces variables dans Vercel.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé secrète "service_role" : utilisée uniquement côté serveur (création des comptes, rappels).
# Ne jamais la partager ni la mettre dans une variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Adresse publique de l'application (pour les liens de réinitialisation du mot de passe)
NEXT_PUBLIC_SITE_URL=https://doomee.vercel.app

# Secret protégeant les rappels automatiques (inventez une longue chaîne aléatoire)
CRON_SECRET=une_longue_chaine_aleatoire
