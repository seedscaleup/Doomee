# ---------------------------------------------------------------------------
# Doomee — local environment. Copy to .env and adjust.
# Every variable is validated by src/lib/env.ts at startup (fail fast).
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 16 (docker compose up -d postgres)
# LOT 1 splits this into per-role URLs (app_user / app_portal / app_migrator).
DATABASE_URL=postgres://doomee:doomee@localhost:5432/doomee

# Object storage — any S3-compatible endpoint (ADR-021).
# Local default is MinIO from docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=doomee-local
S3_ACCESS_KEY_ID=doomee
S3_SECRET_ACCESS_KEY=doomee-secret

# Observability — optional, no-op when unset (D8).
SENTRY_DSN=
LOG_LEVEL=debug
