# ---------------------------------------------------------------------------
# Doomee — local environment. Copy to .env and adjust.
# Every variable is validated by src/lib/env.ts at startup (fail fast).
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 16 (docker compose up -d postgres)
# LOT 1 splits this into per-role URLs (app_user / app_portal / app_migrator).
# app_user / app_portal — subject to row level security.
DATABASE_URL=postgres://doomee_app:change-me-locally@localhost:5432/doomee
# Better Auth: identity tables, no RLS, never granted to app_portal.
DATABASE_AUTH_URL=postgres://doomee:doomee@localhost:5432/doomee
# Login role provisioning (pnpm db:provision). Never commit a real value.
DATABASE_APP_ROLE=doomee_app
DATABASE_APP_PASSWORD=change-me-locally

# Signs sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=development-only-secret-at-least-32-characters-long

# Object storage — any S3-compatible endpoint (ADR-021).
# Local default is MinIO from docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=doomee-local
S3_ACCESS_KEY_ID=doomee
S3_SECRET_ACCESS_KEY=doomee-secret

# Observability — optional, no-op when unset (D8).
SENTRY_DSN=
LOG_LEVEL=debug
